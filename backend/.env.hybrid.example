SECRET_KEY=replace-me
DEBUG=False
APP_ENV=production
DEPLOYMENT_MODE=hybrid
DB_NAME=erp_carton
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=postgres
DB_PORT=5432
ALLOWED_HOSTS=api.example.com,erp.example.com
CORS_ALLOWED_ORIGINS=https://erp.example.com
CSRF_TRUSTED_ORIGINS=https://erp.example.com
CORS_ALLOW_CREDENTIALS=False
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
X_FRAME_OPTIONS=DENY
REFERRER_POLICY=same-origin
USE_X_FORWARDED_PROTO=True
USE_X_FORWARDED_HOST=True
PERMISSION_STRICT_DEFAULT=True
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=False
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_UPDATE_LAST_LOGIN=False
JWT_AUTH_HEADER_TYPES=Bearer
MEDIA_URL=/media/
MEDIA_ROOT=/opt/erp-carton/shared/media
BACKUP_ROOT=/opt/erp-carton/shared/backups
BACKUP_RETENTION_DAYS=14
BACKUP_STALE_HOURS=48
BACKUP_CLOUD_SYNC_ENABLED=True
BACKUP_CLOUD_PROVIDER=rclone
BACKUP_RCLONE_BINARY=rclone
BACKUP_RCLONE_DESTINATION=gdrive:erp-carton-backups
BACKUP_CLOUD_SYNC_STALE_HOURS=72
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_EXPORT_MAX_ROWS=5000
INCIDENT_RUNBOOK_URL=https://runbooks.example.com/erp-carton-go-live
INCIDENT_CONTACT_EMAILS=ops@example.com
ALERT_EMAIL_RECIPIENTS=ops@example.com,owner@example.com
ALERT_SLACK_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_REQUIRED_CHANNEL_COUNT=1
ALERT_REQUIRED_CHANNELS=email
ALERT_HTTP_TIMEOUT_SECONDS=10
API_PUBLIC_URL=https://api.example.com/api
CLOUDFLARED_TUNNEL_ID=replace-me
CLOUDFLARED_CONFIG_PATH=/etc/cloudflared/erp-carton.yml
TUNNEL_PROVIDER=cloudflared
FRONTEND_URL=https://erp.example.com
FRONTEND_PUBLIC_URL=https://erp.example.com
DEFAULT_FROM_EMAIL=ERP Carton <noreply@example.com>
SERVER_EMAIL=ERP Carton <noreply@example.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_TIMEOUT=15
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_FILE_PATH=/opt/erp-carton/shared/sent_emails
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_DIR=/opt/erp-carton/shared/logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
DB_SLOW_QUERY_THRESHOLD_MS=1500
LARGE_DATA_WARNING_ROWS=1000
LARGE_DATA_CRITICAL_ROWS=10000
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=False
Q_CLUSTER_WORKERS=4
Q_CLUSTER_TIMEOUT=90
Q_CLUSTER_RETRY=120
Q_CLUSTER_QUEUE_LIMIT=50
Q_CLUSTER_BULK=10
Q_CLUSTER_SAVE_LIMIT=250
