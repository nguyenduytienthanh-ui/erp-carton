[Unit]
Description=ERP Carton Django-Q Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/erp-carton/backend
EnvironmentFile=/opt/erp-carton/backend/.env
ExecStart=/opt/erp-carton/backend/.venv/bin/python manage.py qcluster
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
